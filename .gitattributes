# Git stores text with LF and checks it out with LF on every platform.
* text=auto eol=lf

# The vendored specification corpora keep their upstream bytes: no line-ending
# normalization, and collapsed in diffs and language statistics.
docs/specs/** linguist-vendored -text
website/book/vendor/** linguist-vendored -text

# The book's reference pages the ferrosmart test reference_pages writes.
website/book/src/reference/** linguist-generated
