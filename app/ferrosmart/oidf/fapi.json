              "task": "Log in at Keycloak",
              "optional": true,
              "match": "http://localhost:8180/realms/ferrosmart/protocol/openid-connect/auth*",
              "commands": [
                ["text", "id", "username", "clinician"],
                ["text", "id", "password", "issued for the run"],
                ["click", "id", "kc-login"]
              ]
            },
            {
              "task": "Approve at FerroSMART's consent page",
              "optional": true,
              "match": "https://localhost.emobix.co.uk:9443/consent*",
              "commands": [
                ["click", "xpath", "//button[@value='approve']"]
              ]
            },
            {
              "task": "Show FerroSMART's error page",
              "optional": true,
              "match": "https://localhost.emobix.co.uk:9443/authorize*",
              "commands": [
                ["wait", "id", "main", 10, "(?s).+", "update-image-placeholder"]
              ]
            },
            {
              "task": "Verify Complete",
              "optional": true,
              "match": "*/test/*/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    }
  }
}
