{
  "alias": "ferrosmart-fapi",
  "description": "FerroSMART as a FAPI 2.0 Security Profile authorization server",
  "server": {
    "discoveryUrl": "https://localhost.emobix.co.uk:9443/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "fapi-suite",
    "scope": "openid fhirUser profile email offline_access",
    "jwks": {
      "keys": ["made for the run"]
    }
  },
  "client2": {
    "client_id": "fapi-suite-2",
    "scope": "openid fhirUser profile email offline_access",
    "jwks": {
      "keys": ["made for the run"]
    }
  },
  "resource": {
    "resourceUrl": "https://localhost.emobix.co.uk:9443/userinfo"
  },
  "browser": [
    {
      "match": "https://localhost.emobix.co.uk:9443/authorize*",
      "tasks": [
        {
          "task": "Log in at Keycloak",
          "optional": true,
          "match": "http://localhost:8180/realms/ferrosmart/protocol/openid-connect/auth*",
          "commands": [
            ["text", "id", "username", "clinician"],
            ["text", "id", "password", "issued for the run"],
            ["click", "id", "kc-login"]
          ]
        },
        {
          "task": "Approve at FerroSMART's consent page",
          "optional": true,
          "match": "https://localhost.emobix.co.uk:9443/consent*",
          "commands": [
            ["click", "xpath", "//button[@value='approve']"]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            ["wait", "id", "submission_complete", 10]
          ]
        }
      ]
    }
  ],
  "override": {
    "fapi2-security-profile-final-user-rejects-authentication": {
      "browser": [
        {
          "match": "https://localhost.emobix.co.uk:9443/authorize*",
          "tasks": [
            {
              "task": "Log in at Keycloak",
              "optional": true,
              "match": "http://localhost:8180/realms/ferrosmart/protocol/openid-connect/auth*",
              "commands": [
                ["text", "id", "username", "patient"],
                ["text", "id", "password", "issued for the run"],
                ["click", "id", "kc-login"]
              ]
            },
            {
              "task": "Deny at FerroSMART's consent page",
              "match": "https://localhost.emobix.co.uk:9443/consent*",
              "commands": [
                ["click", "xpath", "//button[@value='deny']"]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-attempt-reuse-request_uri": {
      "browser": [
        {
          "match": "https://localhost.emobix.co.uk:9443/authorize*",
          "tasks": [
            {
              "task": "Log in at Keycloak",
              "optional": true,
              "match": "http://localhost:8180/realms/ferrosmart/protocol/openid-connect/auth*",
              "commands": [
                ["text", "id", "username", "clinician"],
                ["text", "id", "password", "issued for the run"],
                ["click", "id", "kc-login"]
              ]
            },
            {
              "task": "Approve at FerroSMART's consent page",
              "optional": true,
              "match": "https://localhost.emobix.co.uk:9443/consent*",
              "commands": [
                ["click", "xpath", "//button[@value='approve']"]
              ]
            },
            {
              "task": "Show FerroSMART's error page",
              "optional": true,
              "match": "https://localhost.emobix.co.uk:9443/authorize*",
              "commands": [
                ["wait", "id", "main", 10, "(?s).+", "update-image-placeholder"]
              ]
            },
            {
              "task": "Verify Complete",
              "optional": true,
              "match": "*/test/*/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-attempt-to-use-expired-request_uri": {
      "browser": [
        {
          "match": "https://localhost.emobix.co.uk:9443/authorize*",
